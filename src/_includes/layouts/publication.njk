---
layout: layouts/page.njk
---
<article>
  <header class="entry-header">
    <span class="kicker">{{ journal }}</span>
    <h1>{{ title }}</h1>
    <p class="publi-authors">{{ authors | safe }}</p>
    <p class="publi-venue"><em>{{ journal }}</em>, {{ published or (date | readableDate) }}</p>
    <div class="publi-badges">
      {% if doi %}<a class="badge" href="https://dx.doi.org/{{ doi }}" rel="nofollow noopener noreferrer" title="DOI"><i class="ai ai-doi" aria-hidden="true"></i> {{ doi }}</a>{% endif %}
      {% if isopenaccess %}
        <span class="badge badge--oa" title="Open Access"><i class="ai ai-open-access" aria-hidden="true"></i> Open Access</span>
      {% else %}
        <span class="badge" title="Closed Access"><i class="ai ai-closed-access" aria-hidden="true"></i> Closed Access</span>
      {% endif %}
      {% if doi %}
      <a href="https://plu.mx/plum/a/?doi={{ doi }}" data-popup="bottom" data-size="medium" data-badge="false" class="plumx-plum-print-popup plum-bigben-theme" data-site="plum" data-hide-when-empty="false"></a>
      {% endif %}
    </div>
    {% if tags and tags.length and tags[0] %}
    <ul class="tag-list">
      {% for tag in tags %}
        {% if tag %}<li><a href="/tag/{{ tag | tagSlug }}/">{{ tag }}</a></li>{% endif %}
      {% endfor %}
    </ul>
    {% endif %}
  </header>
  {{ content | safe }}
</article>
