<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}{% if title %} · {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">
  <meta name="twitter:domain" content="bhvieira.github.io">
  <link rel="canonical" href="{{ site.url }}{{ redirect or page.url }}">
  {% if redirect %}
  <meta http-equiv="refresh" content="0; url={{ redirect }}">
  <meta name="robots" content="noindex">
  <script>window.location.replace({{ redirect | dump | safe }});</script>
  {% endif %}

  <script data-goatcounter="https://bhvieira.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon_package/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon_package/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon_package/favicon-16x16.png">
  <link rel="manifest" href="/assets/favicon_package/site.webmanifest">
  <link rel="mask-icon" href="/assets/favicon_package/safari-pinned-tab.svg" color="#5bbad5">
  <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15171b" media="(prefers-color-scheme: dark)">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/academicons.css">
  {% if math %}
  <link rel="stylesheet" href="/libs/katex/katex.min.css">
  {% endif %}
  {% if code %}
  <link rel="stylesheet" href="/libs/highlight/github.min.css">
  {% endif %}
  {% if widget %}
  <link rel="stylesheet" href="/css/{{ widget }}.css">
  {% endif %}
</head>
<body>
  <script type="text/javascript" src="//cdn.plu.mx/widget-popup.js"></script>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-title" href="/">Bruno&nbsp;Hebling&nbsp;Vieira<span class="site-title__mark">·</span></a>
      <div class="site-header__right">
        <nav aria-label="Primary">
          <ul class="site-nav">
            {% set navItems = [
              { url: "/publications/", label: "Publications" },
              { url: "/blog/", label: "Weblog" },
              { url: "/aboutme/", label: "About" }
            ] %}
            {% for item in navItems %}
            <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.indexOf(item.url) == 0) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch between light and dark theme" title="Switch theme">
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z"/></svg>
        </button>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__colophon">
        &copy; {{ site.author }}. Set in a serif face and built with
        <a href="https://www.11ty.dev/">Eleventy</a>; source on
        <a href="https://github.com/bhvieira/bhvieira.github.io">GitHub</a>.
        Opinions here are my own.
      </div>
      <ul class="footer-links">
        <li><a href="https://twitter.com/HeblingVieira" rel="nofollow noopener noreferrer">Twitter</a></li>
        <li><a href="https://github.com/bhvieira" rel="nofollow noopener noreferrer">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/bruno-hebling-vieira-760520142" rel="nofollow noopener noreferrer">LinkedIn</a></li>
        <li><a href="https://stats.stackexchange.com/users/60613/firebug" rel="nofollow noopener noreferrer">CrossValidated</a></li>
        <li><a href="/feed.xml">RSS</a></li>
      </ul>
    </div>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var root = document.documentElement;
        var current = root.getAttribute("data-theme");
        if (!current) {
          current = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        var next = current === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    })();
  </script>

  {% if math %}
  <script src="/libs/katex/katex.min.js"></script>
  <script src="/libs/katex/auto-render.min.js"></script>
  <script>renderMathInElement(document.body);</script>
  {% endif %}
  {% if code %}
  <script src="/libs/highlight/highlight.pack.js"></script>
  <script>hljs.initHighlightingOnLoad(); hljs.configure({ tabReplace: '    ' });</script>
  {% endif %}
  {% if widget %}
  <script defer src="https://d3js.org/d3.v7.min.js"></script>
  <script defer src="/js/{{ widget }}.js"></script>
  {% endif %}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</body>
</html>
