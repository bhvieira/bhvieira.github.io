<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}{% if title %} · {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">
  <meta name="twitter:domain" content="bhvieira.github.io">
  <link rel="canonical" href="{{ site.url }}{{ redirect or page.url }}">
  {% if redirect %}
  <meta http-equiv="refresh" content="0; url={{ redirect }}">
  <meta name="robots" content="noindex">
  <script>window.location.replace({{ redirect | dump | safe }});</script>
  {% endif %}

  <script data-goatcounter="https://bhvieira.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon_package/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon_package/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon_package/favicon-16x16.png">
  <link rel="manifest" href="/assets/favicon_package/site.webmanifest">
  <link rel="mask-icon" href="/assets/favicon_package/safari-pinned-tab.svg" color="#5bbad5">
  <meta name="theme-color" content="#ffffff">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/academicons.css">
  {% if math %}
  <link rel="stylesheet" href="/libs/katex/katex.min.css">
  {% endif %}
  {% if code %}
  <link rel="stylesheet" href="/libs/highlight/github.min.css">
  {% endif %}
  {% if mlvisualizer %}
  <link rel="stylesheet" href="/css/mlvisualizer-custom.css">
  <script>
    window.tailwind = window.tailwind || {};
    window.tailwind.config = { corePlugins: { preflight: false } };
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  {% endif %}
</head>
<body>
  <script type="text/javascript" src="//cdn.plu.mx/widget-popup.js"></script>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-title" href="/">bhvieira</a>
      <ul class="site-nav">
        <li><a href="/publications/">Publications</a></li>
        <li><a href="/blog/">Weblog</a></li>
        <li><a href="/aboutme/">About me</a></li>
      </ul>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div>&copy; {{ site.author }}. Built with <a href="https://www.11ty.dev/">Eleventy</a>. Source on <a href="https://github.com/bhvieira/bhvieira.github.io">GitHub</a>.</div>
      <ul class="footer-links">
        <li><a href="https://twitter.com/HeblingVieira" rel="nofollow noopener noreferrer">Twitter</a></li>
        <li><a href="https://github.com/bhvieira" rel="nofollow noopener noreferrer">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/bruno-hebling-vieira-760520142" rel="nofollow noopener noreferrer">LinkedIn</a></li>
        <li><a href="https://stats.stackexchange.com/users/60613/firebug" rel="nofollow noopener noreferrer">CrossValidated</a></li>
        <li><a href="/feed.xml">RSS</a></li>
      </ul>
    </div>
  </footer>

  {% if math %}
  <script src="/libs/katex/katex.min.js"></script>
  <script src="/libs/katex/auto-render.min.js"></script>
  <script>renderMathInElement(document.body);</script>
  {% endif %}
  {% if code %}
  <script src="/libs/highlight/highlight.pack.js"></script>
  <script>hljs.initHighlightingOnLoad(); hljs.configure({ tabReplace: '    ' });</script>
  {% endif %}
  {% if mlvisualizer %}
  <script src="https://d3js.org/d3.v7.min.js"></script>
  {% endif %}
  <script defer src="https://use.fontawesome.com/releases/v5.8.2/js/all.js" integrity="sha384-DJ25uNYET2XCl5ZF++U8eNxPWqcKohUUBUpKGlNLMchM7q4Wjg2CUpjHLaL8yYPH" crossorigin="anonymous"></script>
</body>
</html>
