---
layout: layouts/page.njk
title: The Weblog
permalink: /blog/
eleventyExcludeFromCollections: true
---
<header class="entry-header">
  <span class="kicker">Notes &amp; howtos</span>
  <h1>The Weblog</h1>
  <p class="entry-meta">Things I wanted to write down before forgetting them. <a href="/feed.xml">Subscribe via RSS</a>.</p>
</header>

{% set years = collections.posts | groupByYear %}
{% for year, items in years %}
<div class="list-year">{{ year }}</div>
<ul class="post-list">
  {% for item in items %}
  <li>
    <a href="{{ item.url }}">{{ item.data.title }}</a>
    <time datetime="{{ item.date | htmlDateString }}">{{ item.data.published or (item.date | readableDate) }}</time>
  </li>
  {% endfor %}
</ul>
{% endfor %}
